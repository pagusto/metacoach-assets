---
import '@fontsource-variable/inter';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
<style is:global>
  body { font-family: 'Inter Variable', system-ui, sans-serif; margin: 2rem; }
</style>
