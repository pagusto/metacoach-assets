---
// Cuadrado: el marco de nueve palacios. Dentro van <Palacio>.
// En escritorio (desde 1280 px) son tres columnas de 9 M y cada <Palacio> se coloca solo
// según su número Lo Shu o sus «celdas»; por debajo, una tira de una columna en el orden
// en que se escriben.
//
//   <Cuadrado>
//     <Palacio n={4} titulo="…">…</Palacio>
//     <Palacio n={2} celdas={[2, 7]} titulo="…">…</Palacio>
//   </Cuadrado>
interface Props {
  /** Clases extra. */
  clase?: string;
  /** id del contenedor. */
  id?: string;
}
const { clase = '', id } = Astro.props;
---
<div id={id} class:list={['loshu', clase]}><slot /></div>
