---
// Cita: la línea de fuente de un dato o de una enseñanza. Si hay URL, enlaza. Como en el resto
// del sitio, la fuente externa se abre en otra pestaña y lo avisa a quien usa lector de pantalla.
//   <Cita fuente={ensenanza.fuente_dato} />
//   <Cita cita="Talmud, Taanit 9a" url="https://www.sefaria.org/Taanit.9a" rotulo="Fuente" />
interface Props {
  /** Objeto Fuente de los JSON: { cita, url }. */
  fuente?: { cita: string; url: string | null } | null;
  /** Texto de la cita, si no se pasa «fuente». */
  cita?: string;
  /** URL, si no se pasa «fuente». */
  url?: string | null;
  /** Rótulo pequeño encima («Fuente», «Estudio»…). */
  rotulo?: string;
  /** Clases extra. */
  clase?: string;
}
const { fuente, rotulo, clase = '' } = Astro.props;
const cita = fuente?.cita ?? Astro.props.cita ?? '';
const url = fuente?.url ?? Astro.props.url ?? null;
---
{cita && (
  <cite class:list={['fuente-cita', clase]}>
    {rotulo && <span class="rotulo">{rotulo}</span>}
    {url ? <a href={url} target="_blank" rel="noopener external">{cita}<span class="oculto"> (se abre en otra pestaña)</span></a> : cita}
  </cite>
)}
