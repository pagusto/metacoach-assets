---
// Datos: el corazón cuantitativo del sitio. Cuatro bloques, cada uno con su retícula:
//   1 · Cifras clave: una rejilla de tres columnas con todas las cifras de datos.json.
//   2 · Gráficos: riqueza por adulto, retornos reales, supervivencia, dinero rápido, fraude, bienestar.
//   3 · Calculadoras: cinco cuentas que no guardan nada (src/lib/datos-calculo.ts).
//   4 · Antes de poner dinero: banderas rojas, reguladores y mitos.
// Todo el contenido sale de src/data/datos.json; el cliente es src/lib/datos-cliente.ts.
import Base from '../layouts/Base.astro';
import TituloPagina from '../components/TituloPagina.astro';
import Cuadrado from '../components/Cuadrado.astro';
import Palacio from '../components/Palacio.astro';
import Etiqueta from '../components/Etiqueta.astro';
import Fuente from '../components/datos/Fuente.astro';
import Barras from '../components/datos/Barras.astro';
import '../styles/datos.css';

import datos from '../data/datos.json';
import { estadoInicial, ingresoReal } from '../lib/store';
import { ruta } from '../lib/ruta';
import { num, conSigno, pctFino, fino, etiquetaDeFuente, leerImporte, agrupar, sinRepetir } from '../lib/datos-formato';
import {
  interesCompuesto, importesReparto, aniosIndependencia, subirPrecio, evaluarFuente, ejeRedondo,
} from '../lib/datos-calculo';
import {
  graficoCompuesto, graficoIndependencia, graficoPrecio, franjaReparto, escalaEvaluador, TASA_MIN, TASA_MAX,
} from '../lib/datos-graficos';
import { PREGUNTAS, PARTES, TEXTO_NIVEL, veredictoBanderas } from '../lib/datos-textos';

// ---------- 1 · Cifras ----------
const cifras = datos.cifras;
const NIVELES = ['alta', 'media', 'baja'] as const;
const PUNTOS = { alta: 3, media: 2, baja: 1 } as const;
const cuenta = (nivel: string) => cifras.filter((c) => c.confianza === nivel).length;
// La celda «Cómo leer» abre la rejilla y ocupa lo que haga falta para cerrar la última fila.
const sobra = (cifras.length + 1) % 3;
const anchoClave = sobra === 0 ? 1 : 1 + (3 - sobra);

// ---------- 2 · Gráficos ----------
const riqueza = datos.riqueza_por_adulto;
const ejeRiqueza = ejeRedondo(Math.max(...riqueza.map((p) => p.media_usd)));
const marcasRiqueza = Array.from({ length: Math.round(ejeRiqueza.tope / ejeRiqueza.paso) + 1 }, (_, i) => {
  const v = i * ejeRiqueza.paso;
  return { v, texto: i % 2 === 0 ? (v === ejeRiqueza.tope ? `${num(v)} USD` : num(v)) : undefined };
});
const filasRiqueza = riqueza.map((p) => ({
  rotulo: p.pais,
  barras: [
    { valor: p.mediana_usd, texto: num(p.mediana_usd), serie: 'oro' as const, nombre: 'Mediana' },
    { valor: p.media_usd, texto: num(p.media_usd), serie: 'tinta' as const, nombre: 'Media' },
  ],
}));
const anioRiqueza = riqueza[0]?.anio;
// riqueza_por_adulto no trae fuente: se enlaza la de la cifra de cada país, cuando existe.
const fuentesRiqueza = riqueza.map((p) => ({
  pais: p.pais,
  fuente: cifras.find((c) => c.geografia === p.pais && /USD por adulto/.test(c.unidad))?.fuente ?? null,
}));

const gruposRetorno = agrupar(datos.retornos_reales, (x) => `${x.periodo}|${x.fuente.cita}`);
const maxRetorno = ejeRedondo(Math.max(...datos.retornos_reales.map((x) => x.retorno_real_anual_pct))).tope;
const notaRetornos = cifras.find((c) => c.id === 'acciones-mundiales-retorno-real')?.nota ?? null;

const supervivencia = [...datos.supervivencia_negocios].sort((a, b) => a.anios - b.anios);
const filasSuperv = supervivencia.map((x) => ({
  rotulo: `${x.pais}, a ${x.anios} ${x.anios === 1 ? 'año' : 'años'}`,
  barras: [{ valor: x.sobrevive_pct, texto: pctFino(x.sobrevive_pct, 1), nombre: 'Siguen abiertos' }],
}));
const notaSuperv = cifras.find((c) => c.id === 'supervivencia-diez-anios')?.nota ?? null;

const rapido = datos.dinero_rapido;

const fraude = agrupar(datos.fraude, (x) => x.pais).map((g) => {
  const filas = [...g.items]
    .sort((a, b) => a.anio - b.anio)
    .map((x) => ({ ...x, importe: leerImporte(x.perdidas) }));
  const conCifra = filas.filter((x) => x.importe);
  const max = conCifra.length ? ejeRedondo(Math.max(...conCifra.map((x) => x.importe!.valor))).tope : 1;
  return { pais: g.clave, unidad: conCifra[0]?.importe?.unidad ?? '', filas, max, fuentes: sinRepetir(filas.map((x) => x.fuente)) };
});
const notaFraude = cifras.find((c) => c.id === 'fraude-eeuu')?.nota ?? null;
// España no tiene importe en «fraude»: se añade su cifra de hechos conocidos, rotulada como recuento.
const hechosEspana = cifras.find((c) => c.id === 'estafas-informaticas-espana') ?? null;

const bienestar = datos.ingreso_y_bienestar;

// ---------- 3 · Calculadoras: valores por defecto, pintados al compilar ----------
const globales = datos.retornos_reales.find((x) => x.activo === 'Acciones globales') ?? datos.retornos_reales[0];
const RETORNO = globales?.retorno_real_anual_pct ?? 5;
const DEF = {
  aporte: 300, anios: 20, retorno: RETORNO,
  ingreso: ingresoReal(estadoInicial()) || 3000, reparto: { dar: 10, ahorrar: 20, vivir: 70 },
  tasa: 20, retornoIndep: 5, multiplo: 25,
  precio: 100, unidades: 40, coste: 60, subida: 10, pierde: 10,
  respuestas: [3, 3, 3, 3],
};
const comp = interesCompuesto(DEF.aporte, DEF.anios, DEF.retorno);
const imp = importesReparto(DEF.ingreso, DEF.reparto);
const aniosIndep = aniosIndependencia(DEF.tasa, DEF.retornoIndep, DEF.multiplo);
const precio = subirPrecio({ precio: DEF.precio, unidades: DEF.unidades, coste: DEF.coste, subidaPct: DEF.subida, pierdePct: DEF.pierde });
const evaluacion = evaluarFuente(DEF.respuestas);
const cifraIndep = cifras.find((c) => c.id === 'ahorro-e-independencia');
const cifraPrecio = cifras.find((c) => c.id === 'precio-uno-por-ciento');

// ---------- 4 · Antes de poner dinero ----------
const banderas = datos.banderas_rojas;
const reguladores = agrupar(datos.reguladores, (x) => x.pais);
const mitos = datos.mitos;

const INDICE = [
  { href: '#cifras', n: cifras.length, texto: 'cifras clave' },
  { href: '#graficos', n: 6, texto: 'gráficos' },
  { href: '#calculadoras', n: 5, texto: 'calculadoras' },
  { href: '#riesgo', n: banderas.length, texto: 'banderas rojas' },
];
---
<Base title="Datos" description="Cifras verificadas sobre cómo se crea, se guarda y se pierde la riqueza, gráficos a escala y cinco calculadoras. Cada dato lleva su fuente, su año y su nivel de confianza.">
  <TituloPagina titulo="Datos" nota="Cifras con fuente, año y nivel de confianza, gráficos a escala y cinco calculadoras. Información general, no consejo financiero personal." />

  <nav class="d-indice" aria-label="Secciones de esta página">
    <ul>
      {INDICE.map((e) => (
        <li><a href={e.href}><span class="cifra">{e.n}</span> {e.texto}</a></li>
      ))}
    </ul>
  </nav>

  <!-- ====================== 1 · Cifras clave ====================== -->
  <div class="d-sec" id="cifras">
    <h2>Cifras clave</h2>
    <p>{cifras.length} cifras, en el orden de los datos: riqueza, origen, inversión, negocio y riesgo</p>
  </div>

  <div class="d-cifras" style={`--ancho-clave:${anchoClave}`}>
    <div class="cf cf-clave">
      <h3 class="cf-t">Cómo leer estas cifras</h3>
      <p class="nota">{fino(datos.resumen)}</p>
      <ul class="conf-clave">
        {NIVELES.map((nivel) => (
          <li>
            <svg class="conf-m" viewBox="0 0 22 6" aria-hidden="true">
              {[0, 1, 2].map((i) => <rect class={i < PUNTOS[nivel] ? 'lleno' : undefined} x={i * 8 + 0.5} y="0.5" width="5" height="5" />)}
            </svg>
            <span>Confianza {nivel}</span>
            <span class="cifra">{cuenta(nivel)}</span>
          </li>
        ))}
      </ul>
    </div>

    {cifras.map((c) => (
      <article class="cf" id={`c-${c.id}`}>
        <h3 class="cf-t">{c.titulo}</h3>
        <p class="cf-v">
          <span class:list={['cifra', 'cf-n', c.valor.length > 8 && 'cf-largo']}>{c.valor}</span>
          <span class="cf-u">{fino(c.unidad)}</span>
        </p>
        <p class="cf-m">
          <span>{c.geografia}</span>
          <span>{c.anio ?? 'sin año'}</span>
          <span class="conf">
            <svg class="conf-m" viewBox="0 0 22 6" aria-hidden="true">
              {[0, 1, 2].map((i) => <rect class={i < (PUNTOS[c.confianza as keyof typeof PUNTOS] ?? 0) ? 'lleno' : undefined} x={i * 8 + 0.5} y="0.5" width="5" height="5" />)}
            </svg>
            Confianza {c.confianza}
          </span>
        </p>
        <details class="cf-d" open>
          <summary>Nota y fuente</summary>
          {c.nota && <p class="nota">{fino(c.nota)}</p>}
          <Fuente fuente={c.fuente} />
        </details>
      </article>
    ))}
  </div>
  <!-- En la tira, la nota y la fuente de cada cifra se pliegan antes de pintar (sin JavaScript quedan abiertas). -->
  <script is:inline>
    if (!window.matchMedia('(min-width: 1280px)').matches) {
      document.querySelectorAll('.cf-d').forEach(function (d) { d.open = false; });
    }
  </script>

  <!-- ====================== 2 · Gráficos ====================== -->
  <div class="d-sec" id="graficos">
    <h2>Gráficos</h2>
    <p>A escala y desde cero. El oro marca el valor medido; la tinta, la referencia</p>
  </div>

  <Cuadrado clase="d-graf">
    <!-- Palacios 4 · 9 -->
    <Palacio n={4} celdas={[4, 9]} titulo="Riqueza por adulto" etiqueta={`USD${anioRiqueza ? `, ${anioRiqueza}` : ''}`} id="riqueza" nivel={3}>
      <p class="d-entrada">La mediana es lo que tiene el adulto del medio. La media reparte el total entre todos: la suben las grandes fortunas.</p>
      <ul class="d-clave" aria-hidden="true">
        <li><svg viewBox="0 0 24 12"><rect class="k-oro" x="0" y="2" width="24" height="8" /></svg>Mediana</li>
        <li><svg viewBox="0 0 24 12"><rect class="k-tinta" x="0" y="5" width="24" height="2" /><line class="k-tinta" x1="23.5" x2="23.5" y1="1" y2="11" /></svg>Media</li>
      </ul>
      <Barras grande clase="bh-lado" filas={filasRiqueza} max={ejeRiqueza.tope} marcas={marcasRiqueza} />
      <div class="d-razon">
        <h4>Media ÷ mediana</h4>
        <p class="rotulo">Cuántas veces supera la media a lo que tiene el adulto del medio</p>
        <dl>
          {riqueza.map((p) => (
            <div><dt>{p.pais}</dt><dd class="cifra">{num(p.media_usd / p.mediana_usd, 1, 1)}</dd></div>
          ))}
        </dl>
      </div>
      <details class="d-tabla">
        <summary>Ver como tabla</summary>
        <div class="tabla-ancha">
          <table class="tabla">
            <caption class="oculto">Riqueza por adulto en dólares: mediana, media y cociente entre ambas</caption>
            <thead><tr><th scope="col">País</th><th scope="col" class="num">Mediana</th><th scope="col" class="num">Media</th><th scope="col" class="num">Media ÷ mediana</th></tr></thead>
            <tbody>
              {riqueza.map((p) => (
                <tr><th scope="row">{p.pais}</th><td class="num">{num(p.mediana_usd)}</td><td class="num">{num(p.media_usd)}</td><td class="num">{num(p.media_usd / p.mediana_usd, 1, 1)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <div slot="pie" class="d-pie">
        <p><Etiqueta tipo="documentado" /></p>
        <p class="fuente-cita">
          UBS, Global Wealth Report 2026, citado por la prensa de cada país:{' '}
          {fuentesRiqueza.map((f, i) => (
            <>{i > 0 && ' · '}{f.fuente?.url
              ? <a href={f.fuente.url} target="_blank" rel="noopener external" title={f.fuente.cita}>{f.pais}<span class="oculto"> (se abre en otra pestaña)</span></a>
              : <span>{f.pais} (sin fuente enlazada en los datos)</span>}</>
          ))}
        </p>
      </div>
    </Palacio>

    <!-- Palacio 2 -->
    <Palacio n={2} titulo="Retorno real anual" etiqueta="Desde 1900" id="retornos" nivel={3}>
      <p class="d-entrada">Lo que rindió cada activo al año, por encima de la inflación.</p>
      <div class="pila pila-3">
        {gruposRetorno.map((g) => (
          <div class="pila pila-1">
            <h4 class="rotulo">{g.items[0].periodo}</h4>
            <Barras
              max={maxRetorno}
              filas={g.items.map((x) => ({ rotulo: x.activo, barras: [{ valor: x.retorno_real_anual_pct, texto: pctFino(x.retorno_real_anual_pct, 1, 1) }] }))}
            />
            <Fuente fuente={g.items[0].fuente} />
          </div>
        ))}
      </div>
      <div slot="pie" class="d-pie">
        {notaRetornos && <p class="nota">{fino(notaRetornos.replace(/^Periodo[^.]*\.\s*/, '').replace(/^Bonos[^.]*\.\s*/, ''))}</p>}
        <p><Etiqueta tipo="documentado" /></p>
      </div>
    </Palacio>

    <!-- Palacio 3 -->
    <Palacio n={3} titulo="Pérdidas por fraude declaradas" etiqueta="Por año y país" id="fraude" nivel={3}>
      <p class="d-entrada">Cada país en su moneda y con su escala: compara los años, no los países.</p>
      <div class="pila pila-3">
        {fraude.map((g) => (
          <div class="pila pila-1">
            <h4 class="d-sub">{g.pais}<span class="rotulo">{g.unidad}</span></h4>
            <Barras
              grande
              max={g.max}
              filas={g.filas.filter((x) => x.importe).map((x) => ({ rotulo: String(x.anio), barras: [{ valor: x.importe!.valor, texto: num(x.importe!.valor) }] }))}
            />
            {g.filas.filter((x) => !x.importe).map((x) => <p class="nota">{x.anio}: {x.perdidas}</p>)}
            {g.fuentes.map((f) => <Fuente fuente={f} />)}
          </div>
        ))}
        {hechosEspana && (
          <div class="pila pila-1">
            <h4 class="d-sub">{hechosEspana.geografia}<span class="rotulo">{hechosEspana.unidad}, no importe</span></h4>
            <p class="d-recuento"><span>{hechosEspana.anio ?? 'sin año'}</span><span class="cifra">{hechosEspana.valor}</span></p>
            {hechosEspana.nota && <p class="nota">{fino(hechosEspana.nota)}</p>}
            <Fuente fuente={hechosEspana.fuente} />
          </div>
        )}
      </div>
      <div slot="pie" class="d-pie">
        {notaFraude && <p class="nota">{fino(notaFraude)}</p>}
        <p><Etiqueta tipo="documentado" /></p>
      </div>
    </Palacio>

    <!-- Palacios 5 · 7 -->
    <Palacio n={5} celdas={[5, 7]} titulo="Dinero rápido: quién pierde" etiqueta={`${rapido.length} vías`} id="dinero-rapido" nivel={3}>
      <ul class="d-rapido d-cols2">
        {rapido.map((x) => (
          <li class="dr">
            <h4>{x.via}</h4>
            {x.pct_pierde != null
              ? <Barras pista cifraAparte max={100} filas={[{ rotulo: 'Pierde', barras: [{ valor: x.pct_pierde, texto: pctFino(x.pct_pierde, 7), nombre: 'Pierde' }] }]} />
              : <p class="dr-sin"><span>Sin porcentaje de pérdida en los datos</span></p>}
            <p>{fino(x.resultado)}</p>
            <div class="dr-pie">
              <Etiqueta tipo={etiquetaDeFuente(x.fuente.cita)} />
              <Fuente fuente={x.fuente} />
            </div>
          </li>
        ))}
      </ul>
    </Palacio>

    <!-- Palacio 8 -->
    <Palacio n={8} titulo="Negocios que siguen abiertos" etiqueta="Supervivencia" id="supervivencia" nivel={3}>
      <p class="d-entrada">De cada cien, cuántos siguen activos pasado ese tiempo.</p>
      <Barras pista cifraAparte max={100} filas={filasSuperv} />
      <p class="nota d-aviso">Las series no se comparan entre sí: cada fuente cuenta un conjunto distinto de empresas.{notaSuperv && ` ${fino(notaSuperv)}`}</p>
      <div slot="pie" class="d-pie">
        <p><Etiqueta tipo="documentado" /></p>
        {sinRepetir(supervivencia.map((x) => x.fuente)).map((f) => <Fuente fuente={f} />)}
      </div>
    </Palacio>

    <!-- Palacios 1 · 6 -->
    <Palacio n={1} celdas={[1, 6]} titulo="Ingreso y bienestar" etiqueta={`${bienestar.length} hallazgos`} id="bienestar" nivel={3}>
      <ol class="d-hallazgos d-cols2">
        {bienestar.map((x, i) => (
          <li>
            <span class="cifra d-orden" aria-hidden="true">{i + 1}</span>
            <p>{fino(x.hallazgo)}</p>
            <div class="dr-pie">
              <Etiqueta tipo={etiquetaDeFuente(x.fuente.cita)} />
              <Fuente fuente={x.fuente} />
            </div>
          </li>
        ))}
      </ol>
    </Palacio>
  </Cuadrado>

  <!-- ====================== 3 · Calculadoras ====================== -->
  <div class="d-sec" id="calculadoras">
    <h2>Calculadoras</h2>
    <p>Cuentas al instante. No guardan nada: al salir de la página se borran</p>
  </div>

  <noscript><p class="muestra">Las calculadoras y la lista de banderas necesitan JavaScript. Las cifras que ves son las de los valores por defecto.</p></noscript>

  <Cuadrado clase="d-calc">
    <!-- 1 · Interés compuesto · palacios 4 · 9 -->
    <Palacio n={4} celdas={[4, 9]} titulo="Interés compuesto" etiqueta="Calculadora 1" id="compuesto" nivel={3}>
      <div class="d-cols2" data-calc="compuesto">
        <div class="pila pila-3">
          <div class="pila">
            <div class="campo">
              <label for="c-aporte">Aporte mensual</label>
              <div class="campo-fila">
                <input id="c-aporte" class="entrada-cifra" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.aporte)} />
                <span class="campo-u">al mes, en tu moneda</span>
              </div>
            </div>
            <div class="campo">
              <label for="c-anios">Plazo</label>
              <div class="d-desliza">
                <input id="c-anios" type="range" min="1" max="50" step="1" value={DEF.anios} />
                <output for="c-anios" data-v="c-anios"><span class="cifra">{DEF.anios}</span> años</output>
              </div>
            </div>
            <div class="campo">
              <label for="c-retorno">Retorno real anual</label>
              <div class="campo-fila">
                <input id="c-retorno" class="entrada-cifra" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.retorno, 2, 0)} />
                <span class="campo-u">% sobre la inflación</span>
              </div>
              <label class="rotulo" for="c-activo">O tómalo de los datos (1900 en adelante)</label>
              <span class="selector">
                <select id="c-activo">
                  {datos.retornos_reales.map((x) => (
                    <option value={x.retorno_real_anual_pct} selected={x === globales}>{x.activo}: {pctFino(x.retorno_real_anual_pct, 1, 1)}</option>
                  ))}
                  <option value="">Otro valor</option>
                </select>
              </span>
            </div>
          </div>
          <div class="res" role="group" aria-label="Resultado del interés compuesto">
            <p class="res-rot">Valor final, en dinero de hoy</p>
            <p class="res-fig"><output class="cifra d-fig" for="c-aporte c-anios c-retorno" data-v="c-final" style={`--n:${num(comp.final).length}`}>{num(comp.final)}</output></p>
            <dl class="res-pares">
              <div><dt>Total aportado</dt><dd class="cifra" data-v="c-aportado">{num(comp.aportado)}</dd></div>
              <div><dt>Crecimiento</dt><dd class="cifra" data-v="c-crecimiento">{num(comp.crecimiento)}</dd></div>
            </dl>
          </div>
        </div>
        <div class="pila">
          <figure class="lc">
            <div class="lc-marco" data-v="c-grafico" tabindex="0" role="slider" aria-label="Año de lectura del gráfico"
              aria-valuemin="0" aria-valuemax={DEF.anios} aria-valuenow={DEF.anios}
              aria-valuetext={`Año ${DEF.anios}: valor ${num(comp.final)}, aportado ${num(comp.aportado)}`}>
              <Fragment set:html={graficoCompuesto(comp)} />
            </div>
            <figcaption class="lc-lectura" data-v="c-lectura">
              <span class="k-linea k-azul" aria-hidden="true"></span>Año {DEF.anios}: valor <b>{num(comp.final)}</b>
              <span class="k-linea k-ref" aria-hidden="true"></span>aportado <b>{num(comp.aportado)}</b>
            </figcaption>
          </figure>
          <p class="rotulo">Eje horizontal: años. Pasa el cursor por el gráfico, o usa las flechas con el foco en él, para leer cada año.</p>
          <details class="d-tabla">
            <summary>Ver año a año</summary>
            <div class="tabla-ancha d-anual" tabindex="0" role="region" aria-label="Tabla año a año">
              <table class="tabla">
                <caption class="oculto">Interés compuesto año a año: total aportado y valor</caption>
                <thead><tr><th scope="col">Año</th><th scope="col" class="num">Aportado</th><th scope="col" class="num">Valor</th></tr></thead>
                <tbody data-v="c-tabla">
                  {comp.serie.slice(1).map((p) => <tr><th scope="row">{p.anio}</th><td class="num">{num(p.aportado)}</td><td class="num">{num(p.valor)}</td></tr>)}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div>
      <div slot="pie" class="d-formula">
        <p class="rotulo">Fórmula</p>
        <p>Valor final = aporte × ((1 + i)<sup>n</sup> − 1) ÷ i, con i = (1 + retorno)<sup>1/12</sup> − 1 y n = 12 × años. Aportas al final de cada mes. Sin impuestos ni comisiones. Rendimientos pasados no anuncian los futuros.</p>
      </div>
    </Palacio>

    <!-- 2 · Reparto del ingreso · palacio 2 -->
    <Palacio n={2} titulo="Reparto del ingreso" etiqueta="Calculadora 2" id="reparto" nivel={3}>
      <div class="pila pila-3" data-calc="reparto">
        <div class="campo">
          <label for="r-ingreso">Ingreso</label>
          <div class="campo-fila">
            <input id="r-ingreso" class="entrada-cifra" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.ingreso)} />
            <span class="campo-u">al mes</span>
          </div>
          <p class="rotulo" data-v="r-origen" hidden>Tomado de tu <a href={ruta('/arbol#libro')}>libro de fuentes</a>. Cámbialo aquí sin tocar lo guardado.</p>
        </div>
        <fieldset class="d-partes">
          <legend class="campo-rot">Tres partes que suman 100</legend>
          {PARTES.map((p) => (
            <div class="d-parte">
              <label for={`r-${p.id}`}><svg class={`fr-muestra fr-m-${p.id}`} viewBox="0 0 12 12" aria-hidden="true"><rect x="0.75" y="0.75" width="10.5" height="10.5" /></svg>{p.nombre}</label>
              <input id={`r-${p.id}`} type="range" min="0" max="100" step="1" value={DEF.reparto[p.id]} data-parte={p.id} />
              <output for={`r-${p.id}`} class="cifra" data-v={`r-pct-${p.id}`}>{pctFino(DEF.reparto[p.id])}</output>
            </div>
          ))}
        </fieldset>
        <div class="d-franja" data-v="r-franja" role="img" aria-label={`Dar ${DEF.reparto.dar} %, ahorrar ${DEF.reparto.ahorrar} %, vivir ${DEF.reparto.vivir} %`}>
          <Fragment set:html={franjaReparto(DEF.reparto)} />
        </div>
        <table class="tabla d-reparto-t">
          <caption class="oculto">Importe de cada parte al mes y al año</caption>
          <thead><tr><th scope="col">Parte</th><th scope="col" class="num">Al mes</th><th scope="col" class="num">Al año</th></tr></thead>
          <tbody>
            {PARTES.map((p) => (
              <tr>
                <th scope="row">{p.nombre}</th>
                <td class="num" data-v={`r-mes-${p.id}`}>{num(imp.mes[p.id])}</td>
                <td class="num" data-v={`r-anio-${p.id}`}>{num(imp.anio[p.id])}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div slot="pie" class="d-formula">
        <p class="rotulo">Fórmula</p>
        <p>Importe al mes = ingreso × parte ÷ 100; al año, por 12. Al mover dar o ahorrar, la diferencia sale de vivir y, si no alcanza, de la otra parte. Al mover vivir, sale de ahorrar y después de dar.</p>
      </div>
    </Palacio>

    <!-- 3 · Años a la independencia · palacios 3 · 5 -->
    <Palacio n={3} celdas={[3, 5]} titulo="Años a la independencia" etiqueta="Calculadora 3" id="independencia" nivel={3}>
      <div class="d-cols2" data-calc="independencia">
        <div class="pila pila-3">
          <div class="pila">
            <div class="campo">
              <label for="i-tasa">Tasa de ahorro</label>
              <div class="d-desliza">
                <input id="i-tasa" type="range" min={TASA_MIN} max={TASA_MAX} step="1" value={DEF.tasa} />
                <output for="i-tasa" data-v="i-tasa"><span class="cifra">{pctFino(DEF.tasa)}</span> del ingreso</output>
              </div>
            </div>
            <div class="campo">
              <label for="i-retorno">Retorno real anual</label>
              <div class="campo-fila">
                <input id="i-retorno" class="entrada-cifra" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.retornoIndep, 2, 0)} />
                <span class="campo-u">% sobre la inflación</span>
              </div>
            </div>
          </div>
          <div class="res" role="group" aria-label="Resultado de los años a la independencia">
            <p class="res-rot">Tiempo hasta vivir de lo ahorrado</p>
            <p class="res-fig"><output class="cifra d-fig" for="i-tasa i-retorno" data-v="i-anios" style={`--n:${num(aniosIndep, 1, 1).length}`}>{num(aniosIndep, 1, 1)}</output> <span class="res-u">años</span></p>
          </div>
          <div class="pila pila-1">
            <h4 class="rotulo">Supuestos</h4>
            <ul class="d-supuestos">
              <li>{fino(`Meta: reunir ${DEF.multiplo} veces tu gasto anual (regla del 4 %).`)}</li>
              <li>Retorno real constante del <span data-v="i-retorno-t">{pctFino(DEF.retornoIndep, 2)}</span> al año, ya descontada la inflación.</li>
              <li>Partes de cero y ahorras cada año la misma parte del ingreso.</li>
              <li>No cuenta impuestos, comisiones ni pensiones.</li>
            </ul>
          </div>
        </div>
        <div class="pila">
          <figure class="lc">
            <div class="lc-marco" data-v="i-grafico" role="img" aria-label={`Curva de años hasta la independencia según la tasa de ahorro. Con el ${DEF.tasa} %, ${num(aniosIndep, 1, 1)} años.`}>
              <Fragment set:html={graficoIndependencia(DEF.tasa, DEF.retornoIndep, DEF.multiplo)} />
            </div>
            <figcaption class="rotulo">Horizontal: parte del ingreso que ahorras. Vertical: años hasta la meta.</figcaption>
          </figure>
          {cifraIndep?.nota && <p class="nota">{fino(cifraIndep.nota)}</p>}
        </div>
      </div>
      <div slot="pie" class="d-formula">
        <p class="rotulo">Fórmula</p>
        <p>Años = ln(1 + {DEF.multiplo} × r × (1 − s) ÷ s) ÷ ln(1 + r), con s la tasa de ahorro y r el retorno real. Si r = 0, años = {DEF.multiplo} × (1 − s) ÷ s.</p>
        {cifraIndep && <Fuente fuente={cifraIndep.fuente} />}
      </div>
    </Palacio>

    <!-- 4 · Subir el precio · palacio 7 -->
    <Palacio n={7} titulo="Subir el precio" etiqueta="Calculadora 4" id="precio" nivel={3}>
      <div class="pila pila-3" data-calc="precio">
        <div class="pila">
          <fieldset class="d-campos d-campos-3">
            <legend class="rotulo">Hoy</legend>
            <div class="campo"><label for="p-precio">Precio actual</label><input id="p-precio" class="d-num" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.precio)} /></div>
            <div class="campo"><label for="p-coste">Coste por unidad</label><input id="p-coste" class="d-num" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.coste)} /></div>
            <div class="campo"><label for="p-unidades">Unidades al mes</label><input id="p-unidades" class="d-num" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.unidades)} /></div>
          </fieldset>
          <fieldset class="d-campos">
            <legend class="rotulo">El cambio</legend>
            <div class="campo"><label for="p-subida">Subes el precio, %</label><input id="p-subida" class="d-num" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.subida)} /></div>
            <div class="campo"><label for="p-pierde">Clientes que se van, %</label><input id="p-pierde" class="d-num" type="text" inputmode="decimal" autocomplete="off" value={num(DEF.pierde)} /></div>
          </fieldset>
        </div>
        <div class="res" role="group" aria-label="Resultado de subir el precio">
          <p class="res-rot">Cambio en el beneficio mensual</p>
          <p class="res-fig">
            <output class="cifra d-fig" for="p-precio p-coste p-unidades p-subida p-pierde" data-v="p-cambio" style={`--n:${conSigno(precio.cambio).length}`}>{conSigno(precio.cambio)}</output>
            <span class="res-u" data-v="p-cambio-pct">{precio.cambioPct != null ? `${conSigno(precio.cambioPct, 1)} %` : ''}</span>
          </p>
          <div class="gp" data-v="p-grafico" role="img" aria-label={`Beneficio mensual: ahora ${num(precio.antes)}, con el precio nuevo ${num(precio.despues)}`}>
            <Fragment set:html={graficoPrecio(precio)} />
          </div>
          <p class="nota" data-v="p-equilibrio">{precio.equilibrioPct != null ? `Equilibrio: ganas lo mismo que ahora si se va el ${pctFino(precio.equilibrioPct, 1)} de los clientes. Por debajo de eso, ganas más.` : ''}</p>
        </div>
      </div>
      <div slot="pie" class="d-formula">
        <p class="rotulo">Fórmula</p>
        <p>Beneficio = (precio − coste por unidad) × unidades. Equilibrio = 1 − (precio − coste) ÷ (precio nuevo − coste). Los costes fijos no cambian la diferencia.</p>
        {cifraPrecio && <p class="nota">Dato: subir el precio un 1{'\u202f'}% dio de media un {fino(`${cifraPrecio.valor} ${cifraPrecio.unidad}`)}. {fino(cifraPrecio.nota ?? '')} <a href={`#c-${cifraPrecio.id}`}>Ver la cifra</a></p>}
      </div>
    </Palacio>

    <!-- 5 · Evaluador · palacios 8 · 1 · 6 -->
    <Palacio n={8} celdas={[8, 1, 6]} titulo="Evaluador de una fuente de ingreso" etiqueta="Calculadora 5" id="evaluador" nivel={3}>
      <div class="d-cols3 d-eval" data-calc="evaluador">
        <div class="d-preguntas">
          {PREGUNTAS.map((q, i) => (
            <fieldset class="d-pregunta">
              <legend><span class="cifra d-orden" aria-hidden="true">{i + 1}</span>{q.texto}</legend>
              <div class="d-escala" data-pregunta={i}>
                {[1, 2, 3, 4, 5].map((v) => (
                  <label>
                    <input class="oculto" type="radio" name={`e-${i}`} value={v} checked={v === DEF.respuestas[i]} />
                    <span class="cifra">{v}</span>
                  </label>
                ))}
              </div>
              <p class="d-anclas rotulo" aria-hidden="true"><span>1 · no</span><span>5 · sí, claramente</span></p>
            </fieldset>
          ))}
        </div>
        <div class="res d-eval-res" role="group" aria-label="Resultado del evaluador">
          <p class="res-rot">Puntuación</p>
          <p class="res-fig"><output class="cifra d-fig" data-v="e-total" style="--n:2">{evaluacion.total}</output> <span class="res-u">de {evaluacion.maximo}</span></p>
          <div data-v="e-escala" role="img" aria-label={`${evaluacion.total} de ${evaluacion.maximo} puntos`}><Fragment set:html={escalaEvaluador(evaluacion.total)} /></div>
          <div class="pila pila-1" role="status">
            <p class="voz-m" data-v="e-titulo">{TEXTO_NIVEL[evaluacion.nivel].titulo}</p>
            <p data-v="e-texto">{TEXTO_NIVEL[evaluacion.nivel].texto}</p>
            <p class="nota" data-v="e-floja"></p>
          </div>
        </div>
      </div>
      <div slot="pie" class="d-formula">
        <p class="rotulo">Fórmula</p>
        <p>Puntuación = suma de las cuatro respuestas, de 4 a 20. De 16 a 20, pruébala; de 12 a 15, refuérzala; de 8 a 11, replantéala; de 4 a 7, déjala por ahora. Es una regla práctica para ordenar ideas, no el resultado de un estudio.</p>
      </div>
    </Palacio>
  </Cuadrado>

  <!-- ====================== 4 · Antes de poner dinero ====================== -->
  <div class="d-sec" id="riesgo">
    <h2>Antes de poner dinero</h2>
    <p>Señales de estafa, dónde comprobar el registro y cinco mitos con su fuente</p>
  </div>

  <Cuadrado clase="d-riesgo">
    <!-- Banderas · palacios 4 · 9 -->
    <Palacio n={4} celdas={[4, 9]} titulo="Banderas rojas" etiqueta={`${banderas.length} señales`} id="banderas" nivel={3}>
      <p class="d-entrada">Piensa en una oportunidad concreta y marca lo que se cumple.</p>
      <ul class="d-banderas d-cols2" style={`--filas:${Math.ceil(banderas.length / 2)}`}>
        {banderas.map((b, i) => (
          <li>
            <label class="d-bandera">
              <input class="casilla" type="checkbox" name="bandera" value={i} />
              <span>{fino(b)}</span>
            </label>
          </li>
        ))}
      </ul>
      <div slot="pie" class="d-veredicto" id="veredicto">
        <p class="d-cuenta">
          <output class="cifra d-cuenta-n" data-v="b-n">0</output>
          <span>de {banderas.length} banderas marcadas</span>
        </p>
        <p class="voz-m" role="status" data-v="b-veredicto">{veredictoBanderas(0)}</p>
        <p><button class="boton-2" type="button" data-v="b-borrar" disabled>Borrar marcas</button></p>
      </div>
    </Palacio>

    <!-- Reguladores · palacio 2 -->
    <Palacio n={2} titulo="Comprueba el registro" etiqueta={`${reguladores.length} países`} id="reguladores" nivel={3}>
      <div class="pila">
        <p class="d-entrada">Busca a la empresa o a la persona en el regulador de tu país antes de pagar.</p>
        <div>
          <dl class="d-reguladores">
            {reguladores.map((g) => (
              <div>
                <dt>{g.clave}</dt>
                {g.items.map((x) => (
                  <dd><a href={x.url} target="_blank" rel="noopener external">{x.nombre}<span class="oculto"> (se abre en otra pestaña)</span></a></dd>
                ))}
              </div>
            ))}
          </dl>
        </div>
      </div>
    </Palacio>

    <!-- Mitos · palacios 3 · 5 · 7 -->
    <Palacio n={3} celdas={[3, 5, 7]} titulo="Mitos" etiqueta={`${mitos.length} afirmaciones`} id="mitos" nivel={3}>
      <ol class="d-mitos">
        {mitos.map((m) => (
          <li class="d-cols3">
            <div class="pila pila-1">
              <p><Etiqueta tipo="mito" /></p>
              <p class="voz-m">«{fino(m.afirmacion.replace(/\.$/, ''))}»</p>
            </div>
            <div class="pila pila-1">
              <p><Etiqueta tipo={etiquetaDeFuente(m.fuente.cita)} /></p>
              <p>{fino(m.realidad)}</p>
            </div>
            <div class="pila pila-1">
              <p class="rotulo d-mito-f">Fuente</p>
              <Fuente fuente={m.fuente} />
            </div>
          </li>
        ))}
      </ol>
    </Palacio>
  </Cuadrado>
</Base>

<script>
  import '../lib/datos-cliente';
</script>
